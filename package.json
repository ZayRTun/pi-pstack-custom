{
  "name": "@zayar/pi-pstack",
  "version": "0.1.10",
  "description": "Personal Pi pstack fork with namespaced skills and optional Sub-agent integration.",
  "license": "MIT",
  "author": "casualjim",
  "keywords": [
    "pi-package",
    "pi",
    "skills",
    "subagent",
    "pstack"
  ],
  "type": "module",
  "files": [
    "extensions/",
    "skills/",
    "agents/",
    "scripts/",
    "provenance.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ZayRTun/pi-pstack-custom"
  },
  "pi": {
    "extensions": [
      "./extensions/pstack"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:upstream": "node scripts/check-upstream.mjs",
    "check:pack": "npm pack --dry-run",
    "test": "bun tests/agents-contract.ts && bun test"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.0.2",
    "@earendil-works/pi-coding-agent": "^1.0.2",
    "@types/node": "^24.13.4",
    "commander": "^15.0.0",
    "typebox": "^1.3.30",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
